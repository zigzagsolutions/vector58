# ---------------------------------------------------------------------------
# Admin portal / API environment. Copy to .env.local for local development.
# NEVER commit real values. Variables without NEXT_PUBLIC_ are server-only.
# ---------------------------------------------------------------------------

# Supabase project URL and publishable (anon) key - safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of this deployment (used for links and agent configuration).
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Server-only: Postgres connection used by trusted server APIs.
# Local Supabase: postgres://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: use the Supavisor transaction pooler URL with sslmode=require.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Server-only: Supabase secret (service-role) key. Used ONLY to invite users
# through the Auth admin API. Optional; without it, users must exist first.
SUPABASE_SECRET_KEY=

# How to determine the client's public IP:
#   vercel   - trust x-real-ip / x-forwarded-for set by Vercel's edge (default on Vercel)
#   xff:<n>  - trust the n-th hop from the right of x-forwarded-for (behind your own proxy)
#   none     - never derive an IP from headers
TRUSTED_PROXY_MODE=none

# Shared secret for scheduled jobs (Supabase Edge Function / Vercel Cron -> /api/internal/*).
CRON_SECRET=

# Comma-separated origins allowed to call cookie-authenticated mutating APIs.
# Defaults to NEXT_PUBLIC_APP_BASE_URL.
ALLOWED_ORIGINS=
