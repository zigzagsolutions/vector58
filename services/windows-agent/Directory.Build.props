<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Allows building Windows-only projects (Tray) on Linux CI; they only run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Company>Vector58</Company>
    <Product>Vector58 Browser Security Agent</Product>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Analyzer rules that conflict with this codebase's conventions. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1031;CA1305;CA1307;CA1310;CA1716;CA1720;CA1724;CA1062;CA1515;CA1711;CA1819;CA2227;CA1056;CA1054;CA1055;CA2234;CA1002;CA1034;CA1822;CA1861;CA1863</NoWarn>
  </PropertyGroup>
</Project>
